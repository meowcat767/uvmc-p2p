
# ============================================================
# Project
# ============================================================

PROJECT_NAME           = "uv-p2p"
PROJECT_BRIEF          = "Peer-to-peer multiplayer infrastructure for Minecraft"
PROJECT_NUMBER         = "0.1.0"

OUTPUT_DIRECTORY       = docs/generated

# ============================================================
# Input
# ============================================================

INPUT                  = src/main/java \
                         docs/architecture

FILE_PATTERNS          = *.java \
                         *.md

RECURSIVE              = YES

EXCLUDE                = build \
                         .gradle \
                         docs/generated

EXCLUDE_PATTERNS       = */build/* \
                         */.gradle/* \
                         */generated/*

# ============================================================
# Extraction
# ============================================================

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = NO

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO

# ============================================================
# Documentation
# ============================================================

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

USE_MDFILE_AS_MAINPAGE = docs/architecture/overview.md

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN            = NO
GENERATE_RTF            = NO

HTML_OUTPUT            = html
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80

GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO

# ============================================================
# Graphs
# ============================================================

HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

CLASS_DIAGRAMS         = YES
UML_LOOK               = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
COLLABORATION_GRAPH    = YES
GRAPHICAL_HIERARCHY    = YES

DOT_GRAPH_MAX_NODES    = 50
MAX_DOT_GRAPH_DEPTH    = 4

# ============================================================
# Warnings
# ============================================================

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_IF_DOC_ERROR      = YES

WARN_AS_ERROR          = NO
QUIET                  = NO

# ============================================================
# Source browsing
# ============================================================

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# ============================================================
# Miscellaneous
# ============================================================

TAB_SIZE               = 4
OPTIMIZE_OUTPUT_JAVA   = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES

GENERATE_TAGFILE       =
